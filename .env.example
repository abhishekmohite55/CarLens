# Copy to .env and fill in. Never commit .env.

# AI and search
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Dev database (docker-compose.yml). Long random passwords.
POSTGRES_PASSWORD=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Backend -> database (same password as POSTGRES_PASSWORD). pytest uses the second one, never the first.
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 (::1) first, Docker listens on IPv4 only (2 min delay).
DATABASE_URL=postgresql://carlens:<POSTGRES_PASSWORD>@127.0.0.1:5432/carlens
TEST_DATABASE_URL=postgresql://carlens:<POSTGRES_PASSWORD>@127.0.0.1:5432/carlens_test
# Backend container -> database: host "postgres" (the compose service). Write @ in the password as %40.
DOCKER_DATABASE_URL=postgresql://carlens:<POSTGRES_PASSWORD>@postgres:5432/carlens
