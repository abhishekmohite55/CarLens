# Copy to .env and fill in. Never commit .env.

# AI and search
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Dev database (docker-compose.yml). Long random passwords.
POSTGRES_PASSWORD=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Backend -> database (same password as POSTGRES_PASSWORD). pytest uses the second one, never the first.
DATABASE_URL=postgresql://carlens:<POSTGRES_PASSWORD>@localhost:5432/carlens
TEST_DATABASE_URL=postgresql://carlens:<POSTGRES_PASSWORD>@localhost:5432/carlens_test
