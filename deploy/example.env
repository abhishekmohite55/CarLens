# Names of every value in deploy/.env, with dummy values. The real deploy/.env is written by deploy.sh from
# Parameter Store (/carlens/prod/<NAME>) and never committed. Used only for the laptop check:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/example.env config
TAG=0000000
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
ORIGIN_HOST=example.duckdns.org
ORIGIN_SECRET=dummy
S3_BUCKET=carlens-runs-example
DATABASE_URL=postgresql://postgres.ref:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
GEMINI_API_KEY=dummy
OPENROUTER_API_KEY=dummy
TAVILY_API_KEY=dummy
LANGFUSE_PUBLIC_KEY=dummy
LANGFUSE_SECRET_KEY=dummy
LANGFUSE_HOST=https://cloud.langfuse.com
GOOGLE_CLIENT_ID=dummy.apps.googleusercontent.com
